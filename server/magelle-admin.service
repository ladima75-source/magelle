[Unit]
Description=MaGelle Admin API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/magelle/server
EnvironmentFile=/etc/magelle-admin.env
ExecStart=/opt/magelle/venv/bin/gunicorn -w 2 -b 127.0.0.1:8787 app:application
Restart=always
RestartSec=3
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
